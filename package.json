{
  "name": "amg-otp-hub",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "export:web": "npx expo export --platform web",
    "desktop:preview": "npm run export:web && npx electron desktop/main.js",
    "build:exe": "npm run export:web && npx electron-builder --win nsis --x64",
    "build:apk": "npx eas-cli build -p android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "expo": "~51.0.0",
    "expo-auth-session": "~5.5.2",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.1",
    "expo-crypto": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.1",
    "expo-router": "~3.5.14",
    "expo-secure-store": "~13.0.2",
    "expo-sqlite": "~14.0.3",
    "expo-status-bar": "~1.12.1",
    "expo-web-browser": "~13.0.3",
    "lucide-react-native": "^0.383.0",
    "motion": "^14.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "^15.16.1",
    "react-native-web": "~0.19.11"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "serve-handler": "^6.1.8",
    "typescript": "~5.3.3"
  },
  "build": {
    "appId": "com.amg.otphub",
    "productName": "AMG OTP Hub",
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "assets/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "release-builds"
    }
  }
}
