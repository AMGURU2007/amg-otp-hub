# AMG OTP Hub - Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Configure Redirect URIs:
#   Web:     http://localhost:8081 (and your production domain)
#   Android: amgotphub:/oauthredirect (Package: com.amg.otphub)

EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_DESKTOP=
